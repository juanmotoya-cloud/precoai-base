{
  "name": "coletor-sefaz",
  "version": "1.0.0",
  "description": "Coletor genérico de preços do Busca Preço SEFAZ-AM para o PreçoAí",
  "main": "index.js",
  "scripts": {
    "test": "npm run validar:catalogo && npm run testar:filtros && npm run testar:coordenadas && npm run testar:busca",
    "validar:catalogo": "node validar-catalogo.js",
    "coletar": "node index.js",
    "coletar:arroz": "node index.js --produto=arroz --max-paginas=2 --marcas",
    "auditar": "node auditar-coleta.js",
    "coletar:teste": "node testar-amostra.js",
    "testar:filtros": "node testar-filtros.js",
    "testar:coordenadas": "node testar-coordenadas.js",
    "testar:busca": "node testar-busca.js",
    "coletar:teste-real": "node index.js --produto=arroz --max-paginas=1 --max-termos=1 --pausa-ms=2000",
    "sincronizar": "node sincronizar-firestore.js --executar",
    "limpar:antigos": "node limpar-antigos.js --executar",
    "limpar:idade": "node limpar-antigos.js --modo=idade --dias=30",
    "sincronizar:simular": "node sincronizar-firestore.js",
    "limpar:simular": "node limpar-antigos.js",
    "atualizar": "node index.js --max-paginas=10 --pausa-ms=2000 --marcas && node sincronizar-firestore.js --executar"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cheerio": "^1.2.0",
    "firebase-admin": "^14.5.0"
  }
}